{
  "manifest_version": 3,
  "name": "Placar Brasileirão",
  "version": "0.2.0",
  "description": "Placar ao vivo do Brasileirão Série A no ícone do Chrome, com avisos de gol dos seus times favoritos.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://site.api.espn.com/*", "https://a.espncdn.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Placar Brasileirão",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
